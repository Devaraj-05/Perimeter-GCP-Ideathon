rules_version = '2';

// Perimeter — owner-bound isolation.
// Directive 3: zero insecure defaults, owner-bound path checking, no
// `allow read, write: if true`. Default deny sits at the bottom of this file
// and is the fallback for every path not explicitly matched above it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Journal entries & reflections — first-party content the user authors.
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny — every path not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
