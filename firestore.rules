rules_version = '2';

// Perimeter - owner-bound isolation with server-only write paths.
//
// Directive 3: zero insecure defaults, owner-bound path checking, no
// `allow read, write: if true`. Default deny sits at the bottom and is the
// fallback for every path not explicitly matched above it.
//
// Amendment A.6: artifacts are written by the Admin SDK only. The Admin SDK
// bypasses these rules entirely, so denying client writes here costs the
// server nothing and removes the client's ability to forge provenance or
// launder a hostile verdict into a clean one.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Journal entries - first-party content the user authors and owns.
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Tracked repositories. The user chooses what to track, so they may
      // create and delete these; run-status fields are server-maintained but
      // are not security-relevant if the owner edits them.
      match /sources/{sourceId} {
        allow read, write: if isOwner(userId);
      }

      // Ingested third-party content. Read-only to the owner, never writable
      // by any client: `trust`, `verdict` and `sourceId` are the inputs to the
      // taint decision, and a client that could edit them could clear its own
      // hostile content.
      match /artifacts/{artifactId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Default deny - every path not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
