# Perimeter — local development environment.
#
# Copy to `.env` (gitignored) and fill in what you need. ONLY the first variable
# is required to run the app locally; every integration below is optional and
# fails only when you use it — a missing secret is reported as a configuration
# error, never as a silent wrong answer.
#
# IN PRODUCTION nothing here is set as a literal secret. Cloud Run receives
# Secret Manager *paths* (the `*_SECRET` variables) and the server fetches the
# values at runtime, version-pinned. See the README's deploy section.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# A Gemini API key from https://aistudio.google.com/apikey
# Local only. In production this is GEMINI_KEY_SECRET instead (see below).
# The server rejects anything not shaped like a real key ("AIza" + 35 chars)
# before it makes a request — an OAuth token pasted here is caught immediately.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"


# ---------------------------------------------------------------------------
# Production — Secret Manager paths, not values
# ---------------------------------------------------------------------------

# Version-pinned on purpose: "latest" makes a rotation silently change what is
# serving, and makes a rollback impossible to describe.
# GEMINI_KEY_SECRET="projects/PROJECT_ID/secrets/GEMINI_API_KEY/versions/1"

# NODE_ENV="production"

# Set automatically by Cloud Run. Only needed if you run against a real
# Firestore from your own machine.
# GOOGLE_CLOUD_PROJECT="perimeter-507310"

# Empty or "(default)" means the default database. Set it only if this
# deployment uses a NAMED Firestore database — pointing at one that does not
# exist is silent data loss.
# FIRESTORE_DATABASE_ID=""


# ---------------------------------------------------------------------------
# Optional — Gmail, read-only (Amendment H, INV-16, INV-17)
# ---------------------------------------------------------------------------
# Two separate secrets on purpose: the OAuth client secret, and a 32-byte key
# that encrypts stored refresh tokens. Separate so database access alone cannot
# use what is in the database.
#
#   openssl rand -base64 32 | tr -d '\n' | gcloud secrets create \
#     GOOGLE_OAUTH_ENC_KEY --data-file=- --replication-policy=automatic

# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_OAUTH_REDIRECT="https://YOUR-RUN-DOMAIN/api/gmail/callback"
# GOOGLE_CLIENT_SECRET_SECRET="projects/PROJECT_ID/secrets/GOOGLE_CLIENT_SECRET/versions/1"
# GOOGLE_OAUTH_ENC_KEY_SECRET="projects/PROJECT_ID/secrets/GOOGLE_OAUTH_ENC_KEY/versions/1"


# ---------------------------------------------------------------------------
# Optional — GitHub account connection (Amendment J, INV-19)
# ---------------------------------------------------------------------------
# The `repo` scope grants read AND WRITE on every private repository the user
# can reach; GitHub has no read-only private scope for OAuth Apps. INV-19 bounds
# what this application requests. It does not bound what the credential permits.

# GITHUB_CLIENT_ID="Iv1...."
# GITHUB_OAUTH_REDIRECT="https://YOUR-RUN-DOMAIN/api/github/callback"
# GITHUB_CLIENT_SECRET_SECRET="projects/PROJECT_ID/secrets/GITHUB_CLIENT_SECRET/versions/1"

# Optional — raises the GitHub API rate limit and reaches private repos for
# issue ingestion. Public repository scanning works without it: the scanner
# downloads the archive in one request. Injected by value rather than by path,
# so it is the one credential not fetched through the Secret Manager SDK.
# GITHUB_TOKEN="ghp_..."


# ---------------------------------------------------------------------------
# Optional — scheduled jobs (/internal/*)
# ---------------------------------------------------------------------------
# The identity Cloud Scheduler must present on its OIDC token. Both must be set
# or the internal routes refuse every request. See docs/scheduler-setup.md.

# SCHEDULER_SERVICE_ACCOUNT="scheduler@PROJECT_ID.iam.gserviceaccount.com"
# SCHEDULER_AUDIENCE="https://YOUR-RUN-DOMAIN/internal/ingest"


# ---------------------------------------------------------------------------
# Optional — tuning. Every one of these has a working default.
# ---------------------------------------------------------------------------

# Per-user, per-hour budgets. Enforced as Firestore transactions, so they hold
# across Cloud Run instances rather than per-process.
# CHAT_RATE_LIMIT_PER_HOUR=60
# NOTE_RATE_LIMIT_PER_HOUR=30
# FILE_RATE_LIMIT_PER_HOUR=20
# GMAIL_RATE_LIMIT_PER_HOUR=10
# REPOSCAN_RATE_LIMIT_PER_HOUR=10
# REDTEAM_RATE_LIMIT_PER_HOUR=20

# How many untrusted artifacts the airlock reads in parallel per turn. Bounded
# rather than unlimited: fifty sources would otherwise open fifty concurrent
# model calls and turn a slow turn into a rate-limited one.
# READER_CONCURRENCY=6

# Bounded mailbox parallelism (Amendment R.4). Each ingest is two model calls.
# GMAIL_FETCH_CONCURRENCY=6
# GMAIL_INGEST_CONCURRENCY=5

# Days before an INGESTED artifact expires. Unset means nothing expires, and the
# in-product privacy statement says exactly that. Your own journal entries are
# never affected by this — a timer never removes your own writing (INV-24).
# ARTIFACT_RETENTION_DAYS=

# Embedding model for semantic search (Amendment P). Changing it makes already
# stored vectors unrankable until their documents are re-ingested.
# GEMINI_EMBED_MODEL="text-embedding-004"

# Set automatically by `firebase emulators:exec` when you run `npm run test:rules`.
# Never set it by hand: pointing the Admin SDK at an emulator that is not running
# makes every write hang rather than fail.
# FIRESTORE_EMULATOR_HOST="localhost:8080"
